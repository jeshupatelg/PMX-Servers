# PMX-Servers Environment Variables (Dummy Values)

# ---------------------------------------------------------
# Container Versions
# ---------------------------------------------------------
KEYCLOAK_VERSION=22.0.1
JENKINS_VERSION=2.426.2
POSTGRES_VERSION=15
KAFKA_VERSION=3.4.0
REDIS_VERSION=7.2-alpine

# ---------------------------------------------------------
# Keycloak Security & Authentication
# ---------------------------------------------------------
KEYCLOAK_CLIENT_SECRET=superSecretDummyString123!@#
KEYCLOAK_ISSUER_URI=https://dummy.example.com/keycloak/realms/dummyrealm
KEYCLOAK_ADMIN_USER=sysadmin_dummy
KEYCLOAK_ADMIN_PASSWORD=secure_password_dummy
KEYCLOAK_HOSTNAME=https://dummy.example.com/keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_secure_password

# ---------------------------------------------------------
# Postgres Database Config
# ---------------------------------------------------------
POSTGRES_USER=dummy_user
POSTGRES_PASSWORD=dummy_password
POSTGRES_DB=dummy_db
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------
# Jenkins CI/CD Container Config
# ---------------------------------------------------------
JENKINS_UID=1000
JENKINS_GID=1000
JENKINS_HOST_PORT=9090

# ---------------------------------------------------------
# Kafka Container Config
# ---------------------------------------------------------
KAFKA_EXTERNAL_PORT=1223

# ---------------------------------------------------------
# Redis Container Config
# ---------------------------------------------------------
REDIS_HOST_PORT=6379
